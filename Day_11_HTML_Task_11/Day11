
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Text Over Image</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .image-container {
            width: 600px;
            height: 350px;
            position: relative;
            margin: 50px auto;
            overflow: hidden;
        }

        .image-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: white;
            text-align: center;
        }

        .text h1 {
            font-size: 40px;
            margin-bottom: 10px;
        }

        .text p {
            font-size: 18px;
        }
    </style>
</head>

<body>

    <div class="image-container">

        <img src="image.jpg" alt="Nature Image">

        <div class="text">
            <h1>Welcome</h1>
            <p>Explore the beautiful world</p>
        </div>

    </div>

</body>
</html>